# ============================================================
# Voice AI Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# cp configs/env.example .env
# ============================================================

# ----- Environment -----
ENVIRONMENT=development
LOG_LEVEL=DEBUG
TZ=Australia/Sydney

# ----- Domain (Production only) -----
DOMAIN=voice-ai.yourdomain.com
API_URL=https://voice-ai.yourdomain.com/api
FRONTEND_URL=https://voice-ai.yourdomain.com

# ============================================================
# DATABASE
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=voice_ai_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full connection URL (constructed from above)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================================
# REDIS
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ============================================================
# AUTHENTICATION
# ============================================================
# JWT Secret - generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-64-character-secret-key-here-generate-with-openssl-rand
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal API Key (for agent-to-backend communication)
# Generate with: openssl rand -hex 16
INTERNAL_API_KEY=your-32-character-internal-key

# ============================================================
# LIVEKIT
# ============================================================
# For local development
LIVEKIT_URL=ws://localhost:7880
# For production: wss://your-livekit-server.com

# Generate keys with: lk create-key
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret0123456789012345678901234567890

# ============================================================
# AI SERVICES
# ============================================================
# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Deepgram (STT) - https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Cartesia (TTS) - https://cartesia.ai
CARTESIA_API_KEY=your-cartesia-api-key-here

# OpenRouter (Optional, alternative LLM) - https://openrouter.ai
OPENROUTER_API_KEY=

# ============================================================
# LIGHTRAG (Knowledge Base)
# ============================================================
LIGHTRAG_URL=http://localhost:9621
LIGHTRAG_API_KEY=your-lightrag-api-key-40-chars-min

# LightRAG LLM Configuration
LIGHTRAG_LLM_MODEL=gpt-4o-mini
# Options: gpt-4o-mini, gpt-4o, google/gemini-flash-1.5 (via OpenRouter)

# LightRAG Embedding Configuration
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_BASE_URL=http://localhost:11434
# For cloud embeddings:
# EMBEDDING_BINDING=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# N8N (MCP Server)
# ============================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=your-n8n-password-here
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_MCP_WEBHOOK_ID=your-webhook-id-from-n8n

# ============================================================
# TELEPHONY (Telnyx)
# ============================================================
TELNYX_API_KEY=KEY_your_telnyx_api_key
TELNYX_API_SECRET=your_telnyx_api_secret

# SIP Trunk Credentials
TELNYX_SIP_USERNAME=your-sip-username
TELNYX_SIP_PASSWORD=your-sip-password

# Phone Numbers (comma-separated E.164 format)
TELNYX_PHONE_NUMBERS=+1234567890,+0987654321

# ============================================================
# TELEPHONY (Twilio - Alternative)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBERS=

# ============================================================
# CREDIT SYSTEM (Rates)
# ============================================================
CREDIT_RATE_INBOUND_CALL_PER_MIN=1.0
CREDIT_RATE_OUTBOUND_CALL_PER_MIN=2.0
CREDIT_RATE_STT_PER_MIN=0.5
CREDIT_RATE_TTS_PER_1K_CHARS=0.05
CREDIT_RATE_LLM_INPUT_PER_1K_TOKENS=0.05
CREDIT_RATE_LLM_OUTPUT_PER_1K_TOKENS=0.15
CREDIT_RATE_RAG_QUERY=0.02
CREDIT_RATE_MIN_BALANCE_FOR_CALLS=1.0
CREDIT_RATE_LOW_BALANCE_WARNING=10.0

# ============================================================
# MONITORING (Optional)
# ============================================================
SENTRY_DSN=
GRAFANA_PASSWORD=your-grafana-password

# Prometheus
PROMETHEUS_ENABLED=true

# ============================================================
# SCALING (Production)
# ============================================================
# Number of voice agent workers
AGENT_REPLICAS=2

# Backend workers
BACKEND_WORKERS=4

# ============================================================
# FEATURE FLAGS
# ============================================================
ENABLE_OUTBOUND_CALLS=true
ENABLE_CALL_RECORDING=false
ENABLE_WEBHOOKS=true

# ============================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================
# ServiceNow
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_ID=

# PMS (Property Management System)
PMS_API_URL=
PMS_API_KEY=

# ============================================================
# EMAIL NOTIFICATIONS
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@yourdomain.com

# ============================================================
# DEVELOPMENT OVERRIDES
# ============================================================
# Set to true to bypass auth in development
DEV_BYPASS_AUTH=false

# Mock external services
DEV_MOCK_TELEPHONY=false
DEV_MOCK_AI_SERVICES=false
